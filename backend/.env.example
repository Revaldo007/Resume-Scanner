# Copy this file to .env and adjust values as needed

# SQLite database file (relative to backend/ folder)
DATABASE_URL=sqlite:///./resume_screening.db

# JWT settings
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Default account created on first start. Other people can sign up via the Register page.
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123

# Upload settings
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=uploads
